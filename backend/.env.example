# Backend env. Generated per-install by setup/write_env.py. Placeholders only.

# Server-side Supabase clients target the local backend proxy on loopback.
SUPABASE_URL=http://127.0.0.1:8001/api
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_GENERATED_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_GENERATED_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=REPLACE_WITH_GENERATED_JWT_SECRET
SUPABASE_ANON_KEY=REPLACE_WITH_GENERATED_ANON_KEY

# Internal upstreams of the self-hosted stack.
GOTRUE_INTERNAL_URL=http://127.0.0.1:9999
POSTGREST_INTERNAL_URL=http://127.0.0.1:3001
PUBLIC_APP_URL=https://YOUR-PREVIEW-HOST

# Server->server secret guarding POST /api/ai/chat. Generated per-install.
AI_PROXY_SECRET=REPLACE_WITH_GENERATED_AI_PROXY_SECRET

# AI (Gemini) via the Emergent Universal Key. Provided by the Emergent
# environment per user; if absent, the AI endpoint reports "ai_not_configured".
# EMERGENT_LLM_KEY=sk-emergent-XXXXXXXXXXXX

# --- Integrations the student configures (empty => "not configured", no calls) ---
