# Frontend public env (browser). Generated per-install by setup/write_env.py.
# Copy to frontend/.env or let setup/install.sh generate it. Placeholders only.

# Public preview URL of THIS clone (auto-discovered by setup on Emergent).
REACT_APP_BACKEND_URL=https://YOUR-PREVIEW-HOST

# Supabase surface is reached through the backend proxy at <URL>/api.
VITE_SUPABASE_URL=https://YOUR-PREVIEW-HOST/api
# Public anon/publishable key (safe to expose). Generated per-install.
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_GENERATED_ANON_KEY
VITE_SUPABASE_PROJECT_ID=atendezap_local

# Optional: set to "true" only when a FULL Supabase with Realtime is connected,
# to disable the polling fallback and use realtime channels.
# VITE_REALTIME_ENABLED=true

# Optional public branding (see MANUAL.md §5)
# VITE_SUPPORT_WHATSAPP=5511999999999
# VITE_SUPPORT_WHATSAPP_DISPLAY=(11) 99999-9999
# VITE_OG_IMAGE_URL=https://your-domain/og-image.png

# --- Server-only keys below (read by SSR/server-functions via vite.config;
#     NEVER shipped to the browser). Generated per-install. Placeholders only. ---
SUPABASE_URL=http://127.0.0.1:8001/api
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_GENERATED_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_GENERATED_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=REPLACE_WITH_GENERATED_JWT_SECRET
AI_PROXY_SECRET=REPLACE_WITH_GENERATED_AI_PROXY_SECRET
